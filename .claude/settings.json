{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(docker compose config:*)",
      "Bash(docker compose -f compose/compose.yaml -f compose/compose.local.yaml config:*)",
      "Bash(yamllint:*)",
      "Bash(ansible-lint:*)",
      "Bash(ansible-playbook --syntax-check:*)",
      "Bash(terraform -chdir=terraform fmt:*)",
      "Bash(terraform -chdir=terraform validate)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate)",
      "Bash(shellcheck:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.tfstate.*)",
      "Read(./**/*.key)",
      "Read(./**/age*.txt)"
    ]
  },
  "enabledMcpjsonServers": [
    "context7"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-git.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {},
  "fastMode": false,
  "env": {
    "CLAUDE_CODE_DISABLE_FAST_MODE": "1"
  },
  "model": "sonnet",
  "effortLevel": "high",
  "attribution": {
    "commit": ""
  }
}
