# Local values for the Cadenway stack on a workstation. Copy this file to compose/.env (never
# committed): Compose reads it from the folder of compose.yaml.
#
# These are development values only. Staging and production take the versions from
# environments/<env>/versions.env and the secrets from environments/<env>/secrets.sops.env.

# Domain the four entries hang from: app., www., api., realtime. (and mail. locally).
DOMAIN=cadenway.localhost
# Scheme of the gateway addresses written into the web application's config.json.
PUBLIC_SCHEME=http
# Host port of Traefik; change it when 80 is taken on the workstation.
TRAEFIK_HTTP_PORT=80
# Contact address of the Let's Encrypt account; unused locally, where Traefik serves plain HTTP.
ACME_EMAIL=dev@cadenway.localhost

# Owner of the images on GHCR; locally the images are built from the sibling folders.
GHCR_OWNER=local

# Shared infrastructure.
POSTGRES_PASSWORD=postgres
NATS_URL=nats://nats:4222
REDIS_URL=redis://redis:6379
MEILI_MASTER_KEY=local-development-master-key

# One database and one user per service: the password given to PostgreSQL, and the URL given to the
# service, which carries the same password.
IDENTITY_DB_PASSWORD=identity
IDENTITY_SERVICE_DATABASE_URL=postgres://identity:identity@postgres:5432/identity
ORGANIZATION_DB_PASSWORD=organization
ORGANIZATION_SERVICE_DATABASE_URL=postgres://organization:organization@postgres:5432/organization
BILLING_DB_PASSWORD=billing
BILLING_SERVICE_DATABASE_URL=postgres://billing:billing@postgres:5432/billing
TASK_DB_PASSWORD=task
TASK_SERVICE_DATABASE_URL=postgres://task:task@postgres:5432/task
DOCUMENT_DB_PASSWORD=document
DOCUMENT_SERVICE_DATABASE_URL=postgres://document:document@postgres:5432/document
STORAGE_DB_PASSWORD=storage
STORAGE_SERVICE_DATABASE_URL=postgres://storage:storage@postgres:5432/storage
NOTIFICATION_DB_PASSWORD=notification
NOTIFICATION_SERVICE_DATABASE_URL=postgres://notification:notification@postgres:5432/notification
AUTOMATION_DB_PASSWORD=automation
AUTOMATION_SERVICE_DATABASE_URL=postgres://automation:automation@postgres:5432/automation
INTEGRATION_DB_PASSWORD=integration
INTEGRATION_SERVICE_DATABASE_URL=postgres://integration:integration@postgres:5432/integration
SEARCH_DB_PASSWORD=search
SEARCH_SERVICE_DATABASE_URL=postgres://search:search@postgres:5432/search

# Image tag of each deployable; `local` names the image built from the sibling folder.
API_GATEWAY_VERSION=local
REALTIME_GATEWAY_VERSION=local
IDENTITY_SERVICE_VERSION=local
ORGANIZATION_SERVICE_VERSION=local
BILLING_SERVICE_VERSION=local
TASK_SERVICE_VERSION=local
DOCUMENT_SERVICE_VERSION=local
STORAGE_SERVICE_VERSION=local
NOTIFICATION_SERVICE_VERSION=local
AUTOMATION_SERVICE_VERSION=local
INTEGRATION_SERVICE_VERSION=local
SEARCH_SERVICE_VERSION=local
WEBAPP_VERSION=local
WEBSITE_VERSION=local
