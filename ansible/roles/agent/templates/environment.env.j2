# Managed by Ansible (cadenway-ops roles/agent). Public settings of the {{ cadenway_environment }}
# environment; its secrets come from environments/{{ cadenway_environment }}/secrets.sops.env.
{% set settings = cadenway_environment_settings[cadenway_environment] %}
ENVIRONMENT={{ cadenway_environment }}
DOMAIN={{ settings.domain }}
PUBLIC_SCHEME={{ settings.public_scheme | default('https') }}
GHCR_OWNER={{ cadenway_ghcr_owner }}
NATS_URL=nats://nats:4222
REDIS_URL=redis://redis:6379
# Addresses on the internal network of the environment: the same on every host, since a service
# listens on the port of its own definition.
MEILI_URL=http://meilisearch:7700
IDENTITY_SERVICE_URL=http://identity-service:3010
ORGANIZATION_SERVICE_URL=http://organization-service:3011
BILLING_SERVICE_URL=http://billing-service:3012
TASK_SERVICE_URL=http://task-service:3013
DOCUMENT_SERVICE_URL=http://document-service:3014
STORAGE_SERVICE_URL=http://storage-service:3015
NOTIFICATION_SERVICE_URL=http://notification-service:3016
AUTOMATION_SERVICE_URL=http://automation-service:3017
INTEGRATION_SERVICE_URL=http://integration-service:3018
SEARCH_SERVICE_URL=http://search-service:3019
