# Managed by Ansible (cadenway-ops roles/agent). Public settings of the {{ cadenway_environment }}
# environment; its secrets come from environments/{{ cadenway_environment }}/secrets.sops.env.
{% set settings = cadenway_environment_settings[cadenway_environment] %}
ENVIRONMENT={{ cadenway_environment }}
DOMAIN={{ settings.domain }}
PUBLIC_SCHEME={{ settings.public_scheme | default('https') }}
GHCR_OWNER={{ cadenway_ghcr_owner }}
NATS_URL=nats://nats:4222
REDIS_URL=redis://redis:6379
