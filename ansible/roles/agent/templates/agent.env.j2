# Managed by Ansible (cadenway-ops roles/agent). Read by /usr/local/bin/cadenway-agent.
CADENWAY_REPO_URL="{{ cadenway_repo_url }}"
CADENWAY_BRANCH={{ cadenway_repo_branch }}
CADENWAY_ENVIRONMENTS="{{ cadenway_environments | join(' ') }}"
CADENWAY_HEALTH_TIMEOUT={{ cadenway_health_timeout }}
SOPS_AGE_KEY_FILE=/etc/cadenway/age.key
GIT_SSH_COMMAND="ssh -i /etc/cadenway/deploy_key -o IdentitiesOnly=yes -o UserKnownHostsFile=/etc/cadenway/known_hosts -o StrictHostKeyChecking=yes"
